{
  "name": "Splunk Enterprise (Free) Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8000, 8088, 8089],
  "portsAttributes": {
    "8000": { "label": "Splunk Web", "onAutoForward": "notify" },
    "8088": { "label": "Splunk HEC", "onAutoForward": "silent" },
    "8089": { "label": "Splunk REST API", "onAutoForward": "silent", "protocol": "https" },
    "9997": { "label": "Forwarder Receiving", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "bash scripts/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "splunk.splunk"
      ]
    }
  }
}
