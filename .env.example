# Copy to .env (done automatically on Codespace creation by scripts/setup.sh)
# .env is gitignored - never commit real passwords or tokens.

# Splunk admin password (min 8 characters)
SPLUNK_PASSWORD=ChangeMe123!

# License: "Free" for Splunk Free; leave empty for the 60-day Enterprise trial
SPLUNK_LICENSE_URI=Free

# HTTP Event Collector token (any GUID). setup.sh generates one for you.
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000
SPLUNK_HEC_SSL=false

# Pin a version for reproducibility, e.g. splunk/splunk:9.4
SPLUNK_IMAGE=splunk/splunk:latest

TZ=America/New_York
